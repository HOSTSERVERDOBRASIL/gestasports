NODE_ENV=production
PORT=3333

# PostgreSQL gerenciado com SSL/backups.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Obrigatório em produção. Use um valor aleatório forte, com pelo menos 32 bytes.
JWT_SECRET="troque-por-um-segredo-forte-e-unico"

# Domínio principal da plataforma. Subdomínios como clube.gestasports.com.br serão aceitos.
SAAS_APP_HOST="gestasports.com.br"

# Origens extras, separadas por vírgula, para domínios customizados de clientes.
CORS_ORIGINS="https://seudominio.com.br,https://www.seudominio.com.br"

# Pix e cobrança manual/provedor.
PIX_KEY=""
PIX_RECEIVER_NAME=""
PIX_CITY=""
PIX_AUTO_SETTLE_SECONDS=20

# E-mail transacional para recuperação de senha e avisos. Obrigatório em produção.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Integrações opcionais.
WHATSAPP_WEBHOOK_URL=""

# Sicoob / Credisc Pix. Preencha quando o provedor SICOOB estiver ativo.
SICOOB_OAUTH_URL=""
SICOOB_PIX_BASE_URL=""
SICOOB_PIX_SCOPE="cob.write cob.read pix.read webhook.write webhook.read"
SICOOB_CERT_PFX_PATH=""
SICOOB_CERT_PATH=""
SICOOB_KEY_PATH=""
SICOOB_CERT_PASSPHRASE=""
