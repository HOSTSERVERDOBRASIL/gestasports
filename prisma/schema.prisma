generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssociateStatus {
  ACTIVE
  LATE
  INACTIVE
}

enum PaymentStatus {
  PAID
  PENDING
  LATE
  REFUNDED
}

enum CollectionStage {
  PRE_DUE_3
  D_PLUS_3
  D_PLUS_7
  D_PLUS_15
}

enum CollectionChannel {
  EMAIL
  WHATSAPP
}

enum ExpenseCategory {
  FIELD
  GOALKEEPERS
  REFEREE
  UNIFORMS
  OTHER
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SPORTS_DIRECTOR
  ASSOCIATE
  ATHLETE
  FINANCIAL
}

enum TenantStatus {
  TRIAL
  ACTIVE
  IMPLEMENTATION
  SUSPENDED
  CANCELED
}

enum TenantDomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum TenantProvisioningStatus {
  NOT_STARTED
  DATABASE_PENDING
  MIGRATING
  READY
  FAILED
}

enum SaaSChargeType {
  MONTHLY
  IMPLEMENTATION
  EXTRA
}

enum SaaSChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum TenantModuleCode {
  ATHLETES
  ASSOCIATES
  CLUBS
  TEAMS
  GAMES
  LINEUPS
  CALLUPS
  COMPETITIONS
  EVENTS
  ATTENDANCE
  RANKINGS
  OFFICIAL_STATS
  FINANCE
  REPORTS
  DOCUMENTS
  COMMUNICATION
  GALLERY
  SETTINGS
}

enum OrganizationType {
  GRUPO_INTERNO
  CLUBE
  CLUBE_COM_RACHA_INTERNO
  LIGA
  ESCOLINHA
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AthletePosition {
  GOALKEEPER
  DEFENDER
  FULLBACK
  MIDFIELDER
  FORWARD
  LINE
  BOTH
  RIGHT_BACK
  LEFT_BACK
  DEFENSIVE_MIDFIELDER
  CENTRAL_MIDFIELDER
  ATTACKING_MIDFIELDER
  RIGHT_WINGER
  LEFT_WINGER
  STRIKER
}

enum AthleteLinkType {
  ASSOCIATE
  CONTRACTED
  GUEST
}

enum AthleteStatus {
  ACTIVE
  INACTIVE
  DELINQUENT
  SUSPENDED
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

enum FinancialEntryStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum FinancialCategory {
  MONTHLY_FEE
  EVENTS
  SPONSORSHIP
  FUNDRAISING
  FIELD
  REFEREE
  GOALKEEPER_CONTRACT
  UNIFORMS
  ADMINISTRATIVE
  REFUND
  OTHER
}

enum GoalkeeperCostModel {
  PER_GAME
  MONTHLY
  ONE_OFF
}

enum GameType {
  INTERNAL
  EXTERNAL
}

enum GameMode {
  INTERNAL_SPLIT
  FRIENDLY
  CHAMPIONSHIP
  TOURNAMENT
  TRAINING
  EXTERNAL_FRIENDLY
}

enum GameStatus {
  SCHEDULED
  RUNNING
  PAUSED
  FINISHED
  CANCELED
}

enum TeamSide {
  RED
  WHITE
  EXTERNAL
}

enum LineupRole {
  STARTER
  RESERVE
  GOALKEEPER
  ABSENT
}

enum EventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
}

enum CardType {
  YELLOW
  RED
}

enum SuspensionOrigin {
  YELLOW_ACCUMULATION
  DIRECT_RED
  MANUAL
}

enum MediaType {
  ATHLETE_PROFILE
  GAME
  CONFRONTATION
  EVENT
  FINANCIAL_RECEIPT
  GENERAL
}

enum ArchiveItemType {
  DASHBOARD
  GAME
  ATHLETE
  DIRECTOR
  TITLE
  MATCH_REPORT
  TIMELINE
  SHIRT
  GALLERY
  DOCUMENT
  AWARD
  ASSET
  HALL_OF_FAME
}

enum ArchiveItemStatus {
  DRAFT
  PUBLISHED
  PRIVATE
}

enum ArchiveAttachmentType {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
  LINK
  OTHER
}

enum ClubEventStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELED
}

enum ClubEventType {
  SOCIAL
  SPORT
  FUNDRAISING
  MEETING
  COMMUNITY
  OTHER
}

enum ClubEventRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELED
  CHECKED_IN
}

enum ClubType {
  INTERNAL
  EXTERNAL
  PARTNER
  GUEST
}

enum FieldStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ClubStatus {
  ACTIVE
  INACTIVE
}

enum TeamCategory {
  PRINCIPAL
  VETERANO
  SUB_20
  SUB_17
  SUB_15
  FEMININO
  MISTO
}

enum TeamGender {
  MALE
  FEMALE
  MIXED
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum CallUpStatus {
  CALLED
  CONFIRMED
  DECLINED
  MAYBE
  ABSENT
  CUT
}

enum CompetitionType {
  LEAGUE
  CUP
  TOURNAMENT
  FRIENDLY_SERIES
}

enum CompetitionFormat {
  PONTOS_CORRIDOS
  MATA_MATA
  GRUPOS
  GRUPOS_E_MATA_MATA
  JOGO_UNICO
  IDA_E_VOLTA
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  FINISHED
  CANCELED
}

enum CompetitionTeamStatus {
  ACTIVE
  WITHDRAWN
}

enum ConfrontationType {
  FRIENDLY
  CHAMPIONSHIP
  TOURNAMENT
  FINAL
  SEMIFINAL
  OTHER
}

enum ConfrontationStatus {
  SCHEDULED
  RUNNING
  FINISHED
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  email        String
  passwordHash String
  role         UserRole @default(ATHLETE)
  associateId  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  associate     Associate?    @relation("UserAssociate", fields: [associateId], references: [id])
  invitedGuests JoinRequest[] @relation("InvitedByUser")
  mediaAssets   MediaAsset[]
  archiveItems  ArchiveItem[]
  roleAssignments UserRoleAssignment[]
  passwordResetTokens PasswordResetToken[]
  auditLogs AuditLog[]
  lineupDraftAttempts LineupDraftAttempt[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model OrganizationTenant {
  id                         String       @id @default(cuid())
  planId                     String?
  name                       String
  slug                       String       @unique
  contactName                String?
  contactEmail               String?
  contactPhone               String?
  status                     TenantStatus @default(IMPLEMENTATION)
  planName                   String       @default("Padrão")
  monthlyFeeCents            Int          @default(0)
  implementationFeeCents     Int          @default(0)
  monthlyDueDay              Int          @default(10)
  defaultSubdomain           String       @unique
  databaseName               String       @unique
  databaseUrl                String?
  provisioningStatus         TenantProvisioningStatus @default(NOT_STARTED)
  provisioningError          String?
  provisionedAt              DateTime?
  brandName                  String?
  primaryColor               String       @default("#dc2626")
  secondaryColor             String       @default("#111827")
  accentColor                String       @default("#facc15")
  logoUrl                    String?
  menuStyle                  String       @default("brand")
  interfaceEffects           String       @default("soft")
  organizationType           OrganizationType @default(CLUBE_COM_RACHA_INTERNO)
  mainClubName               String?
  mainClubLogoUrl            String?
  mainClubPrimaryColor       String?
  mainClubSecondaryColor     String?
  activeCategories           TeamCategory[] @default([])
  usesFinance                Boolean      @default(true)
  usesAssociates             Boolean      @default(true)
  usesExternalGames          Boolean      @default(true)
  usesCompetitions           Boolean      @default(false)
  usesInternalRanking        Boolean      @default(true)
  notes                      String?
  suspendedReason            String?
  activatedAt                DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  domains TenantDomain[]
  charges SaaSCharge[]
  modules TenantModule[]
  plan SaaSPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  users User[]
  groupSettings GroupSettings?
  paymentSettings PaymentSettings?
  joinRequests JoinRequest[]
  associates Associate[]
  boardRoles BoardRole[]
  boardMemberTerms BoardMemberTerm[]
  presidentTerms PresidentTerm[]
  uniformHistories UniformHistory[]
  matches Match[]
  attendances Attendance[]
  payments Payment[]
  collectionActions CollectionActionLog[]
  expenses Expense[]
  goalkeeperContracts GoalkeeperContract[]
  seasons Season[]
  athletes Athlete[]
  athleteTechnicalEvaluations AthleteTechnicalEvaluation[]
  games Game[]
  clubs Club[]
  teams Team[]
  fields Field[]
  gameCallUps GameCallUp[]
  competitions Competition[]
  competitionTeams CompetitionTeam[]
  confrontations Confrontation[]
  gameLineups GameLineup[]
  gameEvents GameEvent[]
  gameSubstitutions GameSubstitution[]
  cardRecords CardRecord[]
  suspensions Suspension[]
  confrontationMatches ConfrontationMatch[]
  financialEntries FinancialEntry[]
  mediaAssets MediaAsset[]
  archiveItems ArchiveItem[]
  memorialCategories MemorialCategory[]
  dashboardLayouts DashboardLayout[]
  dashboardSnapshots TenantDashboardSnapshot[]
  auditLogs AuditLog[]
  lineupDraftAttempts LineupDraftAttempt[]
  clubEvents ClubEvent[]
  clubEventRegistrations ClubEventRegistration[]

  @@index([status, createdAt])
  @@index([contactEmail])
  @@index([planId])
}

model DashboardLayout {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String   @default("ASSOCIATION")
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant OrganizationTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope])
  @@index([tenantId])
}

model TenantDashboardSnapshot {
  id                     String   @id @default(cuid())
  tenantId               String
  scope                  String   @default("ASSOCIATION")
  month                  Int
  year                   Int
  associatesActive       Int      @default(0)
  athletesReady          Int      @default(0)
  monthRevenueCents      Int      @default(0)
  monthExpenseCents      Int      @default(0)
  balanceCents           Int      @default(0)
  delinquencyAmountCents Int      @default(0)
  delinquencyCount       Int      @default(0)
  attendancePercent      Int      @default(0)
  healthScore            Int      @default(0)
  payload                Json
  generatedAt            DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant OrganizationTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, month, year])
  @@index([tenantId, year, month])
  @@index([tenantId, healthScore])
}

model SaaSPlan {
  id                         String             @id @default(cuid())
  name                       String
  slug                       String             @unique
  description                String?
  monthlyFeeCents            Int                @default(0)
  implementationFeeCents     Int                @default(0)
  monthlyDueDay              Int                @default(10)
  maxUsers                   Int?
  maxAthletes                Int?
  maxTeams                   Int?
  customDomainAllowed        Boolean            @default(false)
  moduleCodes                TenantModuleCode[]
  active                     Boolean            @default(true)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  tenants OrganizationTenant[]

  @@index([active, monthlyFeeCents])
}

model PlatformSettings {
  id                         String   @id @default("default")
  platformName               String   @default("GestaSports")
  supportEmail               String   @default("suporte@gestasports.com.br")
  commercialEmail            String   @default("comercial@gestasports.com.br")
  baseDomain                 String   @default("gestasports.com.br")
  defaultTrialDays           Int      @default(14)
  defaultImplementationDays  Int      @default(7)
  defaultBillingGraceDays    Int      @default(7)
  defaultMonthlyDueDay       Int      @default(10)
  autoSuspendEnabled         Boolean  @default(true)
  autoReactivateEnabled      Boolean  @default(true)
  requireVerifiedDomain      Boolean  @default(false)
  allowPathAccess            Boolean  @default(true)
  defaultProvisioningMode    String   @default("AUTOMATIC")
  tenantNamingPattern        String   @default("{slug}")
  auditRetentionDays         Int      @default(180)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model TenantModule {
  id        String           @id @default(cuid())
  tenantId  String
  code      TenantModuleCode
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant OrganizationTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, enabled])
}

model TenantDomain {
  id              String             @id @default(cuid())
  tenantId        String
  hostname        String             @unique
  type            String             @default("CUSTOM")
  status          TenantDomainStatus @default(PENDING)
  expectedCname   String
  lastCheckedAt   DateTime?
  verifiedAt      DateTime?
  failureReason   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant OrganizationTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model SaaSCharge {
  id              String           @id @default(cuid())
  tenantId        String
  type            SaaSChargeType
  description     String
  amountCents     Int
  competenceMonth Int?
  competenceYear  Int?
  dueDate         DateTime
  paidAt          DateTime?
  status          SaaSChargeStatus @default(PENDING)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant OrganizationTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, competenceMonth, competenceYear])
  @@index([status, dueDate])
  @@index([competenceYear, competenceMonth])
}

model LineupDraftAttempt {
  id           String   @id @default(cuid())
  tenantId     String?
  gameId       String
  attemptNumber Int
  createdById  String?
  createdByName String?
  redSnapshot  Json
  whiteSnapshot Json
  redBenchSnapshot Json?
  whiteBenchSnapshot Json?
  blockedSnapshot Json?
  notes        Json?
  totals       Json
  createdAt    DateTime @default(now())

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([gameId, attemptNumber])
  @@index([gameId, createdAt])
  @@index([createdById, createdAt])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  userName    String?
  userEmail   String?
  userRole    UserRole?
  action      String
  method      String
  path        String
  statusCode  Int
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([tenantId, createdAt])
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  role       UserRole
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model GroupSettings {
  id                   String   @id @default(cuid())
  tenantId             String?  @unique
  groupName            String   @default("GestaSports")
  organizationType     String   @default("ASSOCIACAO")
  foundedAt            DateTime?
  foundationYear       Int?
  documentNumber       String?
  phone                String?
  email                String?
  websiteUrl           String?
  address              String?
  addressNumber        String?
  neighborhood         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String   @default("Brasil")
  history              String?
  playersPerTeam       Int      @default(11)
  closedMode           Boolean  @default(true)
  inviteCode           String?
  uniform1Name         String   @default("Time A")
  uniform1Season       String?
  uniform1Color        String   @default("#94a3b8")
  uniform1ImageUrl     String?
  uniform2Name         String   @default("Time B")
  uniform2Season       String?
  uniform2Color        String   @default("#cbd5e1")
  uniform2ImageUrl     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PaymentSettings {
  id                   String   @id @default(cuid())
  tenantId             String?  @unique
  paymentMode          String   @default("MANUAL_PIX")
  paymentProvider      String   @default("MANUAL_PIX")
  providerEnvironment  String   @default("TEST")
  providerApiKey       String?
  providerClientId     String?
  providerClientSecret String?
  providerWebhookSecret String?
  providerWebhookUrl   String?
  autoSettleEnabled    Boolean  @default(false)
  pixKey               String
  pixReceiverName      String
  pixCity              String
  pixAutoSettleSeconds Int      @default(20)
  monthlyDueDay        Int      @default(10)
  lateFeeCents         Int      @default(0)
  lateFeePercent       Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model JoinRequest {
  id                   String            @id @default(cuid())
  tenantId             String?
  name                 String
  email                String
  phone                String?
  message              String?
  invitedByAssociateId String
  invitedByUserId      String
  status               JoinRequestStatus @default(PENDING)
  createdAt            DateTime          @default(now())
  reviewedAt           DateTime?

  tenant             OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByAssociate Associate @relation(fields: [invitedByAssociateId], references: [id], onDelete: Restrict)
  invitedByUser      User      @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, email, status])
  @@index([status, createdAt])
  @@index([tenantId, status, createdAt])
}

model Associate {
  id              String          @id @default(cuid())
  tenantId        String?
  name            String
  email           String?
  phone           String?
  status          AssociateStatus @default(ACTIVE)
  monthlyFeeCents Int             @default(6000)
  boardRoleId     String?
  joinedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?            @relation("UserAssociate")
  payments         Payment[]
  attendances      Attendance[]
  invitedGuests    JoinRequest[]
  athlete          Athlete?
  collectionActions CollectionActionLog[]
  boardRole        BoardRole?       @relation(fields: [boardRoleId], references: [id], onDelete: SetNull)
  boardMemberTerms BoardMemberTerm[]
  financialEntries FinancialEntry[]
  clubEventRegistrations ClubEventRegistration[]
  coachedTeams     Team[] @relation("TeamCoachAssociate")
  assistantTeams   Team[] @relation("TeamAssistantAssociate")
  address          String?
  birthDate        DateTime?
  note             String?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([boardRoleId])
}

model BoardRole {
  id                 String      @id @default(cuid())
  tenantId           String?
  name               String
  description        String?
  canAccessAdmin     Boolean     @default(false)
  canAccessFinancial Boolean     @default(false)
  canAccessAthlete   Boolean     @default(false)
  isDefault          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  associates Associate[]
  boardMemberTerms BoardMemberTerm[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model BoardMemberTerm {
  id             String   @id @default(cuid())
  tenantId       String?
  associateId    String
  boardRoleId    String
  startedYear    Int
  endedYear      Int?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  associate Associate           @relation(fields: [associateId], references: [id], onDelete: Cascade)
  boardRole BoardRole           @relation(fields: [boardRoleId], references: [id], onDelete: Restrict)

  @@index([tenantId, startedYear, endedYear])
  @@index([associateId])
  @@index([boardRoleId])
}

model UniformHistory {
  id          String   @id @default(cuid())
  tenantId    String?
  side        String
  seasonLabel String
  seasonYear  Int?
  name        String
  color       String
  imageUrl    String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, side, seasonLabel])
  @@index([tenantId, seasonYear])
}

model PresidentTerm {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  startedYear  Int
  endedYear    Int?
  photoUrl     String?
  note         String?
  achievements String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([startedYear, endedYear])
  @@index([tenantId, startedYear, endedYear])
}

model Match {
  id        String   @id @default(cuid())
  tenantId  String?
  opponent  String
  location  String
  startsAt  DateTime
  costCents Int
  createdAt DateTime @default(now())

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([tenantId, startsAt])
}

model Attendance {
  id          String  @id @default(cuid())
  tenantId    String?
  associateId String
  matchId     String
  confirmed   Boolean @default(false)

  tenant    OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([associateId, matchId])
  @@index([tenantId, matchId])
}

model Payment {
  id                  String        @id @default(cuid())
  tenantId            String?
  associateId         String
  month               Int
  year                Int
  amountCents         Int
  dueDate             DateTime
  paidAt              DateTime?
  status              PaymentStatus @default(PENDING)
  lateFeeAppliedCents Int           @default(0)
  refundedAt          DateTime?
  refundReason        String?
  createdAt           DateTime      @default(now())

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  collectionActions CollectionActionLog[]

  @@index([year, month])
  @@index([tenantId, year, month])
}

model CollectionActionLog {
  id          String            @id @default(cuid())
  tenantId    String?
  associateId String
  paymentId   String
  stage       CollectionStage
  channel     CollectionChannel
  sentAt      DateTime          @default(now())
  success     Boolean           @default(true)
  message     String?

  tenant OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, stage, channel])
  @@index([sentAt])
