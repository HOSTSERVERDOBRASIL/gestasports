model Game {
  id                String    @id @default(cuid())
  tenantId          String?
  type              GameType
  date              DateTime
  location          String
  championship      String?
  gameMode          GameMode  @default(INTERNAL_SPLIT)
  homeClubId        String?
  awayClubId        String?
  fieldId           String?
  homeTeamId        String?
  awayTeamId        String?
  competitionId     String?
  round             String?
  matchNumber       Int?
  isOfficial        Boolean   @default(false)
  homeScore         Int?
  awayScore         Int?
  refereeName       String?
  assistantNames    String?
  assistantOneName  String?
  assistantTwoName  String?
  fourthOfficialName String?
  reserveAssistantName String?
  varName           String?
  avarName          String?
  delegateName      String?
  note              String?
  gameValueCents    Int       @default(0)
  seasonId          String?
  redTeamName       String?
  whiteTeamName     String?
  redUniformColor   String?
  whiteUniformColor String?
  redUniformImageUrl   String?
  whiteUniformImageUrl String?
  redCrestUrl       String?
  whiteCrestUrl     String?
  redFormation      String?
  whiteFormation    String?
  status            GameStatus @default(SCHEDULED)
  halfDurationMinutes Int      @default(45)
  breakDurationMinutes Int     @default(15)
  startedAt         DateTime?
  pausedAt          DateTime?
  elapsedSeconds    Int        @default(0)
  finishedAt        DateTime?
  redScore          Int?
  whiteScore        Int?
  winnerSide        TeamSide?
  isDraw            Boolean   @default(false)
  tacticalPlans     Json?
  draftAttempts     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant        OrganizationTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  season        Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeClub      Club?               @relation("GameHomeClub", fields: [homeClubId], references: [id], onDelete: SetNull)
  awayClub      Club?               @relation("GameAwayClub", fields: [awayClubId], references: [id], onDelete: SetNull)
  field         Field?              @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  homeTeam      Team?               @relation("GameHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam      Team?               @relation("GameAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  competition   Competition?        @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  callUps       GameCallUp[]
  lineups       GameLineup[]
  events        GameEvent[]
  substitutions GameSubstitution[]
  cards         CardRecord[]
  confrontation ConfrontationMatch?
  mediaAssets   MediaAsset[]
  draftHistory  LineupDraftAttempt[]

  @@index([type, date])
  @@index([tenantId, type, date])
  @@index([tenantId, fieldId])
  @@index([tenantId, gameMode, date])
  @@index([tenantId, homeClubId, awayClubId])
  @@index([tenantId, competitionId])
  @@index([seasonId])
}

