  awayClub Club @relation("ConfrontationAwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)
  homeTeam Team? @relation("ConfrontationHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam Team? @relation("ConfrontationAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
