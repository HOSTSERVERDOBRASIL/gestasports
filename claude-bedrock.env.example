# Copy this file to claude-bedrock.local.env and fill only the values you use.
# claude-bedrock.local.env is intentionally ignored by git because it can contain secrets.

# Required for Bedrock. Keep us-east-1 if your Bedrock API key/model access is there.
AWS_REGION=us-east-1

# Option A: Bedrock API key.
# Never commit your real key.
AWS_BEARER_TOKEN_BEDROCK=

# Option B: AWS profile/credentials instead of a Bedrock API key.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: pin Claude Code to a specific Bedrock inference profile if needed.
# Claude Sonnet 4 on Bedrock does not support direct on-demand model IDs like:
# anthropic.claude-sonnet-4-20250514-v1:0
# Use the inference profile ID instead:
# ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# ANTHROPIC_SMALL_FAST_MODEL=
