{
  "name": "gestasports-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm run frontend:build",
    "check": "npm run build:all && npm run frontend:lint && npm run prisma:validate",
    "test": "npm run test:security",
    "test:security": "node scripts/security-preflight.cjs",
    "tenant:audit": "node scripts/tenant-null-audit.cjs",
    "tenant:backfill": "node scripts/backfill-legacy-tenant.cjs",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "tenant:provision": "tsx scripts/provision-tenant.ts",
    "tenant:rename-pilot": "tsx scripts/rename-pilot-gestasports.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node scripts/prisma-validate-local-engine.cjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "deploy:prepare": "npm run prisma:generate && npm run build:all",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.41.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
